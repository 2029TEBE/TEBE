# COPY to .env.staging on the STAGING SERVER. Never commit the filled file.
# Non-billing staging: keep all payment providers disabled until Paddle's signed sandbox webhooks and authorization are verified.
# Database secrets must come from an approved secret store.
# Generate three DIFFERENT strong passwords and URL-encode DATABASE_URL's password.
PG_USER=pmo_admin
PG_PASSWORD=
PG_DB=pmo
REDIS_PASSWORD=
DATABASE_URL=postgres://pmo_app:REPLACE_WITH_LONG_URL_ENCODED_PASSWORD@postgres:5432/pmo
REDIS_URL=redis://:REPLACE_WITH_LONG_URL_ENCODED_PASSWORD@redis:6379

WEB_ORIGIN=https://staging.theepmo.com
PUBLIC_API_URL=https://api-staging.theepmo.com
WEB_PORT=3001
WEB_BIND=127.0.0.1

# Staging runs a production-built application with all legacy billing disabled.
# This is not Paddle implementation. Do not use a live payment key or live webhook.
DEPLOYMENT_ENV=staging
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_TEST_MODE_IN_PRODUCTION=false
STRIPE_WEBHOOK_PUBLIC_URL=
BILLING_REFERENCE_WEBHOOK_ENABLED=false

# Phase 13A invitations: disabled until SES sender/domain verification.
MAIL_TRANSPORT=none
MAIL_FROM=
MAIL_REGION=ap-south-1
